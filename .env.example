DATABASE_URL="postgresql://realestate:realestate@localhost:5544/realestate?schema=public"

NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Canonical public origin — used for receipt links and QR codes
# (must be https://belgrovehomes.com in production, never localhost).
# The ONLY variable read by src/lib/app-url.ts getAppUrl().
APP_URL="https://belgrovehomes.com"

SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_USER="info@belgrovehomes.com"
SMTP_PASS=""
SMTP_FROM="Belgrove Homes <info@belgrovehomes.com>"
# Zoho — app password for info@belgrovehomes.com (production). Set in .env as ZOHO_APP_PASSWORD
ZOHO_APP_PASSWORD=""

# Monthly sales goal in Naira — powers the admin sidebar + dashboard target widget
MONTHLY_SALES_TARGET="150000000"

ADMIN_ALERT_EMAILS="admin@belgrovehomes.example"

SEED_ADMIN_EMAIL="admin@belgrovehomes.example"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_NAME="Admin"

# Dev email safety (enforced at the sendEmail transport layer).
# Outside production, every outgoing email is redirected to EMAIL_DEV_REDIRECT
# (required in dev) and the subject is prefixed with [DEV].
EMAIL_DEV_REDIRECT="dev-inbox@belgrovehomes.example"
# Optional: comma-separated allowlist. When set, recipients not on the list are
# dropped (logged) instead of sent, even if EMAIL_DEV_REDIRECT is set.
EMAIL_DEV_ALLOWLIST=""

# Secret protecting POST /api/cron/outbox (email outbox processor).
CRON_SECRET="replace-with-a-long-random-string"
