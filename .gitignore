# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
# Generated binary-asset bundle (rebuilt by scripts/embed-assets.ts on postinstall).
/src/lib/receipts/embedded-assets.ts
# Generated Chromium pack for serverless renders (rebuilt by
# scripts/pack-chromium.ts during `next build`; served from the CDN).
/public/chromium-pack.tar
exports/
/public/receipts/*.pdf
/storage/
.tmp/
